[Unit]
Description=SeekLib Web Dashboard (Gunicorn)
After=network.target

[Service]
Type=simple
User=seeklib
WorkingDirectory=/home/seeklib/seeklib
ExecStart=/home/seeklib/seeklib/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
